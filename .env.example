# ==============================================================================
# VARUN-Blend (SIH26081) - Hybrid AI-NWP Multi-Model Blending System
# Environment Configuration for Vercel Deployment & Local Development
# ==============================================================================

# 1. WEATHER DATA API:
# Powered by Open-Meteo (https://open-meteo.com).
# NO API KEY OR CREDIT CARD REQUIRED! Open-Meteo provides free, generous multi-model
# access to ECMWF IFS, NOAA GFS, DWD ICON, and historical atmospheric reanalysis.

# 2. GEMINI AI BULLETIN API (Optional Free Tier):
# Used for automated Chief Meteorologist Operational Bulletins.
# Free-tier Gemini keys can be generated at: https://aistudio.google.com/
# If this key is missing or quota is exhausted, the app automatically and gracefully
# falls back to the built-in IMD Operational Synoptic Rule Engine with ZERO errors.
GEMINI_API_KEY=""

# 3. APPLICATION RUNTIME URL (Optional):
# In Vercel, this is automatically provided by VERCEL_URL.
APP_URL=""

# 4. OPTIONAL MERN PERSISTENCE:
# Create a free MongoDB Atlas cluster and paste its connection string here.
# Without this variable, live forecasts and Vercel serverless APIs still work;
# only Express snapshot and pipeline history persistence is disabled.
MONGODB_URI=""

# 5. LOCAL EXPRESS SERVER:
PORT=4000
